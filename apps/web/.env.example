# Public frontend configuration. These values may appear in the browser bundle.
# Keep OpenAI/Twilio keys, JWT secrets, and passwords ONLY in services/api/.env.

# Relative path uses Vite's development proxy or your production reverse proxy.
VITE_API_BASE_URL=/api/v1

# Optional full WebSocket URL, e.g. wss://api.example.com/api/v1/voice/ws.
# Leave empty to derive it from VITE_API_BASE_URL and the frontend origin.
VITE_VOICE_WS_URL=

# Development server only; NOT included in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:8000
