# Backend only. Copy to .env and replace the credential placeholders.
# Do not commit .env or put these secrets in the frontend.

# SQLite for local development; PostgreSQL requires the psycopg driver.
DATABASE_URL=sqlite:///./voice.db

# Required: generate a random secret of at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
# Used to create the first administrator. Password must have 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Exact frontend origins, comma-separated without spaces.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for live AI responses; leave empty to keep provider access disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: required only for real phone calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS API origin for signed Twilio callbacks, without a trailing slash.
PUBLIC_BASE_URL=https://your-public-api.example.com

# Outbound safeguards. Enable only after configuring credentials and consent.
OUTBOUND_ENABLED=false
# E.164 recipient numbers, comma-separated without spaces.
OUTBOUND_ALLOWLIST=
DAILY_CALL_LIMIT=10
MAX_CALL_SECONDS=300
